node_modules/

# Next.js build output (matches site/.next/ and site/out/ at any depth)
.next/
out/

# TypeScript incremental build info
*.tsbuildinfo

# Python
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment files. .env.example is tracked on purpose if one is ever added.
.env*
!.env.example

dist/
build/
.DS_Store
*.log

report_diff_output.txt

# Untracked 2026-10-24 by the encoding repair. Each quotes corrupted
# text verbatim, so scripts/check_mojibake.py can never pass while they
# are tracked, and none can be regenerated. Kept on local disk; see
# docs/report-2026/AUDIT.md.
docs/report-2026/scratch/moj.txt
outputs/repro/page_diff.txt
outputs/repro/deqdata_diff.txt
outputs/repro/void_block.txt
outputs/repro/limitations_block.txt

# Third-party bulk downloads, per DECISIONS.md D30. The full GWAS Catalog
# release files are 120 MB together and the associations file is a zip git
# cannot pack. They are pinned by SHA-256 and dated release URL in
# pipeline/sources/manifest.json and data/reports/2026/FREEZE.json, and the
# committed asthma extracts beside them are what the report reads. Re-download
# with scripts/fetch_gwas_catalog.py.
pipeline/sources/gwas-catalog/gwas-catalog-associations_ontology-annotated-full.zip
pipeline/sources/gwas-catalog/gwas-catalog-download-ancestries-v1.0.3.1.tsv

# Draft report PDFs and their sidecars, per DECISIONS.md D34. A draft is built for
# review, is never served, and leaves pdf_path in data/reports/2026/index.json alone.
# The final PDF is committed under site/public/reports/<year>/ when --final produces
# it, because Vercel runs only the site build and cannot render one.
docs/report-2026/drafts/
